{
  "manifest_version": 3,
  "name": "AMOLED Pure Black Theme – Totality",
  "version": "1.0.0",
  "description": "True-black theme for OLED screens: pure #000 tabs and toolbar, warm text, and a solar eclipse on the new tab page.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "theme": {
    "images": {
      "theme_ntp_background": "images/ntp.png"
    },
    "colors": {
      "frame":                                  [0, 0, 0],
      "frame_inactive":                         [0, 0, 0],
      "frame_incognito":                        [0, 0, 0],
      "frame_incognito_inactive":               [0, 0, 0],
      "background_tab":                         [0, 0, 0],
      "background_tab_inactive":                [0, 0, 0],
      "background_tab_incognito":               [0, 0, 0],
      "background_tab_incognito_inactive":      [0, 0, 0],
      "toolbar":                                [0, 0, 0],
      "button_background":                      [0, 0, 0, 0],

      "tab_text":                               [239, 228, 207],
      "tab_background_text":                    [124, 116, 102],
      "tab_background_text_inactive":           [87, 81, 74],
      "tab_background_text_incognito":          [124, 116, 102],
      "tab_background_text_incognito_inactive": [87, 81, 74],
      "toolbar_text":                           [239, 228, 207],
      "toolbar_button_icon":                    [207, 197, 178],
      "bookmark_text":                          [190, 180, 162],

      "omnibox_text":                           [239, 228, 207],
      "omnibox_background":                     [18, 15, 11],

      "ntp_background":                         [0, 0, 0],
      "ntp_header":                             [0, 0, 0],
      "ntp_text":                               [239, 228, 207],
      "ntp_link":                               [242, 71, 111]
    },
    "tints": {
      "buttons": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "top",
      "ntp_background_repeat": "no-repeat",
      "ntp_logo_alternate": 1
    }
  }
}
